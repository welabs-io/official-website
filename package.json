{
  "name": "welabs-website",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "iterate": "node scripts/iterate.mjs",
    "gate": "npm run lint && npm run typecheck && npm test && npm run iterate && PORTFOLIO_PREVIEW_URL=${PORTFOLIO_PREVIEW_URL:-http://127.0.0.1:5176} node scripts/check-portfolio.mjs && playwright test"
  },
  "dependencies": {
    "@imagineapps-team/common": "0.0.11",
    "@imagineapps-team/react": "0.18.0",
    "@tanstack/react-query": "^5.104.5",
    "@use-gesture/react": "^10.3.1",
    "imask": "7.6.1",
    "motion": "^12.43.0",
    "next": "^16.3.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.90.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "axe-core": "4.13.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
