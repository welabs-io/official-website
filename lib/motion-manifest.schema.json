{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://welabs.local/schemas/motion-manifest/1.2.json",
  "title": "Welabs motion manifest v5 (schema 1.2.0)",
  "description": "Additive revision of motion-manifest.schema.v1.1.json: every 1.1 field is kept with the same meaning. The chain is drawn in two blocks. The top block (overview) is built by the site in SVG and CSS from the data of each step: the active nodes, the token (Pedido 1234) that travels from one node to another between overview.from and overview.to, and a label of at most 6 words. The bottom block (detail) is a clip of an accepted product piece, full tile, that shows what happens inside the product of the step. Each steps[] item gains `overview` and `detail` (both required); the flat fields piece/from/to/settledAt/rate/holdAfter/covers/poster/measure/srLabel stay and equal the detail, because the time of the step is the time of its detail and the overview follows it. overview.from and overview.to are seconds of piece time of the detail piece, inside [detail.from, detail.to]: the token leaves at the first motion of the detail and lands at settledAt. chain.fallback keeps the 1.1 step shape. Times are seconds of piece time, three decimals; a segment plays [from, to] at `rate`, freezes on its last frame for `holdAfter` screen seconds and hands off; settledAt is the first piece time after which the frame is pixel-still (difference measured at 1/30 s); to = settledAt + 0.1.",
  "type": "object",
  "required": [
    "schema",
    "schemaVersion",
    "round",
    "brandVersion",
    "generatedAt",
    "source",
    "brand",
    "player",
    "defaults",
    "pieces",
    "chain",
    "products"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "welabs-motion-manifest/1"
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^1\\.[0-9]+\\.[0-9]+$"
    },
    "round": {
      "type": "string"
    },
    "brandVersion": {
      "type": "string"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "object",
      "required": [
        "round",
        "roundHead",
        "exportDir"
      ],
      "additionalProperties": false,
      "properties": {
        "round": {
          "type": "string"
        },
        "roundHead": {
          "type": "string",
          "pattern": "^[0-9a-f]{7,40}$"
        },
        "exportDir": {
          "type": "string"
        },
        "plan": {
          "type": "string"
        }
      }
    },
    "brand": {
      "type": "object",
      "required": [
        "welabs",
        "sealRule",
        "endorse"
      ],
      "additionalProperties": false,
      "properties": {
        "welabs": {
          "description": "Brand files version served from _shared/brand (manifest of the round).",
          "type": "string"
        },
        "sealRule": {
          "description": "Rule version of the 'by welabs' seal (x-height >= 14 px).",
          "type": "string"
        },
        "endorse": {
          "description": "Default for the 'by welabs' seal on small logos inside pieces (data-endorse on the piece). Opening pieces that form the logo carry it regardless; see pieces[].endorse.",
          "enum": [
            "on",
            "off"
          ]
        }
      }
    },
    "player": {
      "type": "object",
      "required": [
        "package",
        "version",
        "src"
      ],
      "additionalProperties": false,
      "properties": {
        "package": {
          "const": "hyperframes"
        },
        "version": {
          "type": "string"
        },
        "src": {
          "type": "string"
        }
      }
    },
    "defaults": {
      "type": "object",
      "required": [
        "holdAfter",
        "transitionBetweenSteps",
        "minScreenSeconds"
      ],
      "additionalProperties": false,
      "properties": {
        "holdAfter": {
          "type": "number",
          "minimum": 1
        },
        "minScreenSeconds": {
          "description": "Floor of (to - from) / rate for a segment with text to read.",
          "type": "number"
        },
        "transitionBetweenSteps": {
          "$ref": "#/$defs/transition"
        }
      }
    },
    "pieces": {
      "description": "Every piece the site copies, keyed by piece id. The site serves `src` as is.",
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/piece"
      }
    },
    "chain": {
      "type": "object",
      "required": [
        "status",
        "loop",
        "variants",
        "steps"
      ],
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "final",
            "fallback"
          ]
        },
        "loop": {
          "type": "boolean"
        },
        "cycleSeconds": {
          "description": "Screen seconds of one cycle: sum of (to - from) / rate plus holdAfter of every step.",
          "type": "number"
        },
        "variants": {
          "type": "object",
          "required": [
            "desktop"
          ],
          "additionalProperties": false,
          "properties": {
            "desktop": {
              "type": [
                "string",
                "null"
              ]
            },
            "mobile": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/chainStep"
          }
        },
        "fallback": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/chainStepV11"
          }
        }
      }
    },
    "products": {
      "type": "object",
      "required": [
        "domus",
        "relloo",
        "magneto",
        "tuner",
        "knowly"
      ],
      "additionalProperties": false,
      "properties": {
        "domus": {
          "$ref": "#/$defs/product"
        },
        "relloo": {
          "$ref": "#/$defs/product"
        },
        "magneto": {
          "$ref": "#/$defs/product"
        },
        "tuner": {
          "$ref": "#/$defs/product"
        },
        "knowly": {
          "$ref": "#/$defs/product"
        }
      }
    }
  },
  "$defs": {
    "slug": {
      "enum": [
        "domus",
        "relloo",
        "magneto",
        "tuner",
        "knowly"
      ]
    },
    "measure": {
      "type": "object",
      "required": [
        "method",
        "status"
      ],
      "additionalProperties": false,
      "properties": {
        "method": {
          "enum": [
            "pixel-diff-1/30s",
            "pixel-diff-0.5s",
            "authored-spec"
          ]
        },
        "status": {
          "enum": [
            "measured",
            "provisional",
            "spec"
          ]
        },
        "evidence": {
          "type": "string"
        }
      }
    },
    "transition": {
      "type": "object",
      "required": [
        "type",
        "duration"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "cut",
            "push-left",
            "push-up",
            "blend"
          ]
        },
        "duration": {
          "type": "number",
          "minimum": 0
        },
        "ease": {
          "type": "string"
        }
      }
    },
    "cover": {
      "type": "object",
      "required": [
        "t",
        "w1280",
        "w640"
      ],
      "additionalProperties": false,
      "properties": {
        "t": {
          "description": "Piece time of the frame (seconds).",
          "type": "number",
          "minimum": 0
        },
        "w1280": {
          "description": "Site path of the 1280 px WebP.",
          "type": "string"
        },
        "w640": {
          "description": "Site path of the 640 px WebP (phones).",
          "type": "string"
        }
      }
    },
    "covers": {
      "type": "object",
      "required": [
        "start",
        "settled"
      ],
      "additionalProperties": false,
      "properties": {
        "start": {
          "description": "Entry cover: the frame 0.5 s after `from` (the first content already on screen).",
          "$ref": "#/$defs/cover"
        },
        "settled": {
          "description": "Frame at settledAt: the neighbour's cover and the reduced-motion frame.",
          "$ref": "#/$defs/cover"
        }
      }
    },
    "segment": {
      "type": "object",
      "allOf": [
        {
          "$ref": "#/$defs/segmentCore"
        }
      ],
      "unevaluatedProperties": false
    },
    "piece": {
      "type": "object",
      "required": [
        "src",
        "sha256",
        "sourceSha256",
        "duration",
        "width",
        "height",
        "siteVariant",
        "posters",
        "endorse"
      ],
      "additionalProperties": false,
      "properties": {
        "src": {
          "description": "Site path of the site copy (index.html).",
          "type": "string"
        },
        "sha256": {
          "description": "sha256 of the site copy index.html (accepted piece plus the hide rule).",
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "sourceSha256": {
          "description": "sha256 of the accepted piece in the round (accepted.json).",
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "duration": {
          "description": "Composition duration (data-duration, seconds).",
          "type": "number"
        },
        "width": {
          "type": "integer"
        },
        "height": {
          "type": "integer"
        },
        "minDisplayWidth": {
          "type": "integer"
        },
        "endorse": {
          "description": "State of the 'by welabs' seal in this accepted piece: on = sealed logos as accepted, off = standalone logos.",
          "enum": [
            "on",
            "off"
          ]
        },
        "siteVariant": {
          "type": "object",
          "required": [
            "hide"
          ],
          "additionalProperties": false,
          "properties": {
            "hide": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "posters": {
          "description": "Every cover file of the piece (both widths).",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "connection": {
      "type": "object",
      "required": [
        "from",
        "to",
        "value",
        "label"
      ],
      "additionalProperties": false,
      "properties": {
        "from": {
          "$ref": "#/$defs/slug"
        },
        "to": {
          "anyOf": [
            {
              "$ref": "#/$defs/slug"
            },
            {
              "const": "outcome"
            }
          ]
        },
        "input": {
          "type": "string"
        },
        "output": {
          "type": "string"
        },
        "value": {
          "description": "Internal value sentence: guides authoring and QA; never displayed.",
          "type": "string"
        },
        "label": {
          "description": "Short value the site may display: pt-BR, sentence case, at most 3 words and 24 characters, no mechanism name.",
          "type": "string",
          "maxLength": 24,
          "pattern": "^[^ ]+( [^ ]+){0,2}$"
        }
      }
    },
    "overview": {
      "description": "Top block, drawn by the site (SVG and CSS, not video): the product flow with the token that carries the order.",
      "type": "object",
      "required": [
        "nodes",
        "token",
        "from",
        "to",
        "label"
      ],
      "additionalProperties": false,
      "properties": {
        "nodes": {
          "description": "Nodes lit while the step is active (the products the detail shows).",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/slug"
          }
        },
        "token": {
          "description": "The token (Pedido 1234) walks from node `from` to node `to`; 'outcome' is the end of the chain.",
          "type": "object",
          "required": [
            "from",
            "to"
          ],
          "additionalProperties": false,
          "properties": {
            "from": {
              "$ref": "#/$defs/slug"
            },
            "to": {
              "anyOf": [
                {
                  "$ref": "#/$defs/slug"
                },
                {
                  "const": "outcome"
                }
              ]
            }
          }
        },
        "from": {
          "description": "Piece time (seconds) of the detail piece at which the token leaves its node: the first motion of the detail.",
          "type": "number",
          "minimum": 0
        },
        "to": {
          "description": "Piece time at which the token lands: the settledAt of the detail.",
          "type": "number",
          "minimum": 0
        },
        "label": {
          "description": "Caption of the top block: pt-BR, sentence case, at most 6 words and 48 characters.",
          "type": "string",
          "maxLength": 48,
          "pattern": "^[^ ]+( [^ ]+){0,5}$"
        }
      }
    },
    "detail": {
      "description": "Bottom block: a clip of an accepted piece of the product itself. Its time is the time of the step.",
      "type": "object",
      "required": [
        "piece",
        "from",
        "to",
        "settledAt",
        "rate",
        "hold",
        "covers",
        "srLabel"
      ],
      "additionalProperties": false,
      "properties": {
        "piece": {
          "type": "string"
        },
        "from": {
          "type": "number",
          "minimum": 0
        },
        "to": {
          "type": "number",
          "minimum": 0
        },
        "settledAt": {
          "type": "number",
          "minimum": 0
        },
        "rate": {
          "type": "number",
          "minimum": 1,
          "maximum": 2.5
        },
        "hold": {
          "description": "Screen seconds the last frame is held (same as the step's holdAfter).",
          "type": "number",
          "minimum": 1
        },
        "covers": {
          "$ref": "#/$defs/covers"
        },
        "srLabel": {
          "description": "One short sentence for screen readers describing what happens inside the product.",
          "type": "string",
          "minLength": 8,
          "maxLength": 140
        },
        "story": {
          "description": "Whether the clip carries the Marina and Pedido 1234 story or is a generic product film.",
          "enum": [
            "marina",
            "generic"
          ]
        }
      }
    },
    "chainStepV11": {
      "type": "object",
      "allOf": [
        {
          "$ref": "#/$defs/segmentCore"
        },
        {
          "type": "object",
          "required": [
            "step",
            "srLabel",
            "products",
            "connection",
            "transition"
          ],
          "properties": {
            "step": {
              "type": "integer",
              "minimum": 0
            },
            "srLabel": {
              "description": "One short sentence for screen readers (accessible name of the active step).",
              "type": "string",
              "minLength": 8,
              "maxLength": 140
            },
            "products": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/slug"
              }
            },
            "connection": {
              "$ref": "#/$defs/connection"
            },
            "transition": {
              "$ref": "#/$defs/transition"
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "chainStep": {
      "type": "object",
      "allOf": [
        {
          "$ref": "#/$defs/segmentCore"
        },
        {
          "type": "object",
          "required": [
            "step",
            "srLabel",
            "products",
            "connection",
            "transition",
            "overview",
            "detail"
          ],
          "properties": {
            "step": {
              "type": "integer",
              "minimum": 0
            },
            "srLabel": {
              "description": "One short sentence for screen readers (accessible name of the active step).",
              "type": "string",
              "minLength": 8,
              "maxLength": 140
            },
            "products": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/slug"
              }
            },
            "connection": {
              "$ref": "#/$defs/connection"
            },
            "transition": {
              "$ref": "#/$defs/transition"
            },
            "overview": {
              "$ref": "#/$defs/overview"
            },
            "detail": {
              "$ref": "#/$defs/detail"
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "film": {
      "type": "object",
      "required": [
        "piece",
        "role",
        "title",
        "proves",
        "segments"
      ],
      "additionalProperties": false,
      "properties": {
        "piece": {
          "type": "string"
        },
        "role": {
          "enum": [
            "main",
            "support"
          ]
        },
        "title": {
          "description": "Accessible name of the film (screen readers).",
          "type": "string"
        },
        "proves": {
          "type": "string"
        },
        "segments": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/segment"
          }
        },
        "poster": {
          "description": "Entry cover of the first segment (w1280).",
          "type": "string"
        },
        "endPoster": {
          "description": "Settled cover of the last segment (w1280).",
          "type": "string"
        }
      }
    },
    "product": {
      "type": "object",
      "required": [
        "order",
        "group",
        "intro",
        "films"
      ],
      "additionalProperties": false,
      "properties": {
        "order": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "group": {
          "enum": [
            "core",
            "rail"
          ]
        },
        "intro": {
          "$ref": "#/$defs/segment"
        },
        "films": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/film"
          }
        }
      }
    },
    "segmentCore": {
      "type": "object",
      "required": [
        "piece",
        "from",
        "to",
        "settledAt",
        "rate",
        "holdAfter",
        "poster",
        "covers",
        "transition",
        "measure"
      ],
      "properties": {
        "piece": {
          "type": "string"
        },
        "variant": {
          "description": "'site' = the piece's site copy (hidden slots such as .role); only the intro carries it.",
          "const": "site"
        },
        "title": {
          "description": "Accessible name of an intro segment.",
          "type": "string"
        },
        "from": {
          "type": "number",
          "minimum": 0
        },
        "to": {
          "type": "number",
          "minimum": 0
        },
        "settledAt": {
          "type": "number",
          "minimum": 0
        },
        "rate": {
          "type": "number",
          "minimum": 1,
          "maximum": 2.5
        },
        "holdAfter": {
          "type": "number",
          "minimum": 1
        },
        "poster": {
          "description": "Settled cover at 1280 px (same as covers.settled.w1280).",
          "type": "string"
        },
        "covers": {
          "$ref": "#/$defs/covers"
        },
        "transition": {
          "description": "How the site leaves this segment for the next item.",
          "$ref": "#/$defs/transition"
        },
        "measure": {
          "$ref": "#/$defs/measure"
        }
      }
    }
  }
}
